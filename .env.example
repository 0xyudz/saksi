# ── Persistence ───────────────────────────────────────────────────────────────
DATABASE_URL=

# ── Walrus Memory ─────────────────────────────────────────────────────────────
WALRUS_MEMORY_PRIVATE_KEY=
WALRUS_MEMORY_ACCOUNT_ID=
WALRUS_MEMORY_RELAYER_URL=
WALRUS_MEMORY_NAMESPACE_PREFIX=

# ── Tatum Sui RPC ─────────────────────────────────────────────────────────────
TATUM_API_KEY=
TATUM_SUI_RPC_URL=
SUI_NETWORK=
SUI_USDC_COIN_TYPE=
AGENT_SUI_ADDRESS=
# Optional: required only by `pnpm verify:tatum`
TATUM_VERIFY_DIGEST=

# ── x402 (Tentacle Pay facilitator) ──────────────────────────────────────────
X402_FACILITATOR_URL=
X402_PAY_TO_ADDRESS=
# USD ("$0.01") or atomic units ("10000"). Next.js expands a literal "$0" in
# .env.local, so prefer the atomic form there; the app normalises both.
X402_PRICE=
# Flat fee a seller pays to publish one signal, in the same format as X402_PRICE.
# Defaults to "$0.02". It is settled as its own x402 payment to X402_PAY_TO_ADDRESS
# before the listing becomes visible, so the platform is paid without ever holding
# a seller's sale proceeds. Anything below 0.01 USDC cannot be gas-sponsored on Sui
# and is rejected at startup.
X402_LISTING_FEE=
# Optional: required only by `pnpm verify:x402`. Browser buyers sign with their own
# wallet, so the app itself never needs this key.
X402_CLIENT_PRIVATE_KEY=
# Optional: required only by `pnpm verify:x402`
X402_TEST_SIGNAL_ID=

# ── Independent result oracle ─────────────────────────────────────────────────
# Base URL of the scoreboard API used to confirm outcomes. Saksi understands one
# league (`espn:eng.1`) and match-winner markets; every other outcome stays
# self-attested and is labelled as such.
ORACLE_ESPN_BASE_URL=
# "false" leaves every outcome self-attested. Defaults to true.
ORACLE_ENABLED=

# ── App ──────────────────────────────────────────────────────────────────────
APP_BASE_URL=
# At least 32 characters. Signs the session cookie; generate with `openssl rand -base64 32`.
SESSION_SECRET=
LOG_LEVEL=
# Optional tuning (defaults live in lib/env.ts)
WALRUS_RECALL_LIMIT=
# Per-instance Postgres pool. Lower it on serverless (e.g. 3) to protect a small
# Postgres plan; the default is 10.
DB_POOL_MAX=
