{
  "name": "saksi",
  "version": "0.1.0",
  "private": true,
  "description": "Saksi — a prediction journal that cannot lie. Sealed picks, verifiable outcomes, memory-driven recommendations, and x402 premium signals settled on Sui.",
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "verify:memory": "tsx scripts/verify-memory.ts",
    "verify:tatum": "tsx scripts/verify-tatum.ts",
    "verify:x402": "tsx scripts/verify-x402.ts",
    "demo:provider": "tsx scripts/demo-signal-provider.ts"
  },
  "dependencies": {
    "@mysten-incubation/memwal": "^0.1.11",
    "@mysten/seal": "1.5.2",
    "@mysten/sui": "^2.38.0",
    "@mysten/walrus": "1.2.37",
    "@tentaclepay/sui-x402": "^2.1.12",
    "@x402/core": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "@x402/next": "^2.28.0",
    "@x402/paywall": "^2.28.0",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.3",
    "pino": "^10.4.0",
    "postgres": "^3.4.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
